# Public build-time origin, never a secret.
VITE_SITE_URL=https://weathersair.com
# Same-origin Vercel function (default).
VITE_FORM_ENDPOINT=/api/contact
# SERVER ONLY: configure in Vercel. Never prefix this with VITE_.
RESEND_API_KEY=
# Optional comma-separated exact origins for authorized preview testing.
FORM_ALLOWED_ORIGINS=
