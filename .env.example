# Copy to .env (or set in your hosting provider's environment settings).

# Where the contact form and newsletter signup POST their JSON payload.
# Works with Formspree (https://formspree.io/f/xxxxxxx), Web3Forms, Basin,
# or your own serverless function. Leave unset and the form falls back to a
# pre-filled email instead.
VITE_FORM_ENDPOINT=

# Canonical origin of the deployed site, used for canonical URLs, Open Graph
# tags and schema.org markup. No trailing slash.
VITE_SITE_URL=https://weathers.aurexagency.com
